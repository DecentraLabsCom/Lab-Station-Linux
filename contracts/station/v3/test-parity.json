{
  "source": "Lab Gateway/docs/station-test-parity.json",
  "version": 2,
  "portableStatus": {
    "schemaVersion": "3.0.0",
    "requiredFields": [
      "schemaVersion",
      "timestamp",
      "host",
      "version",
      "platform",
      "profile",
      "management",
      "remoteAccess",
      "summary",
      "readiness",
      "sessions",
      "operations",
      "localModeEnabled"
    ],
    "profiles": ["dedicated", "hybrid", "fmu-only"],
    "summaryStates": ["ready", "degraded", "unavailable", "unknown"],
    "readinessCapabilities": ["physicalLab", "wake", "fmu"],
    "sessionKinds": ["local", "management", "remote", "service", "unknown"],
    "sessionRequiredFields": ["kind", "active", "evictable"],
    "primaryCapabilityByProfile": {
      "dedicated": "physicalLab",
      "hybrid": "physicalLab",
      "fmu-only": "fmu"
    },
    "readyState": "ready",
    "notReadyStates": ["degraded", "unavailable"]
  },
  "platforms": {
    "windows": {
      "os": "windows",
      "managementTransport": "winrm"
    },
    "linux": {
      "os": "linux",
      "managementTransport": "ssh"
    }
  },
  "sessionSafety": {
    "unavailableInventory": "fail-closed",
    "localSession": "protect-unless-authorized",
    "prepareDecision": {
      "noLocalSession": "continue",
      "dedicatedLocalSession": "refuse",
      "hybridLocalSessionWithoutAuthorization": "refuse",
      "hybridLocalSessionWithAuthorization": "evict"
    }
  },
  "prepareCleanup": {
    "requiredCategories": ["temporary", "application-cache", "downloads", "scratch", "recent-items"],
    "preserveCategories": ["managed-application-configuration"]
  },
  "localMode": {
    "malformedLegacyMarker": "active-until-explicit-clear",
    "expiredLegacyTimestamp": "inactive"
  },
  "leaseExpiry": {
    "unexpiredLease": "retain",
    "expiredLease": "release-once"
  },
  "operationStatus": {
    "missingOperation": "not-found",
    "persistedOperation": "return-record"
  },
  "power": {
    "action": "shutdown",
    "requireWake": true,
    "wakeReady": false,
    "expected": "blocked"
  },
  "recovery": {
    "safeStationExpected": "no-reboot"
  },
  "sharedScenarios": [
    {
