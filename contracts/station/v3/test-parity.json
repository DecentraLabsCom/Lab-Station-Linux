      "windows": {
        "file": "labstation/tests/TelemetryTests.ahk",
        "test": "TestV3EnvelopeHasPortableRequiredFields"
      },
      "linux": {
        "file": "internal/agent/daemon_test.go",
        "test": "TestDaemonPublishesBothContractSnapshotsAndStopsOnContextCancellation"
      }
    },
    {
      "id": "sessions.unavailable-inventory-fails-closed",
      "windows": {
        "file": "labstation/tests/SessionGuardTests.ahk",
        "test": "TestSessionQueryFailureIsReported"
      },
      "linux": {
        "file": "internal/agent/agent_test.go",
        "test": "TestPrepareSessionFailsClosedWhenSessionInventoryUnavailable"
      }
    },
    {
      "id": "sessions.protect-local-user-unless-authorized",
      "windows": {
        "file": "labstation/tests/SessionGuardTests.ahk",
        "test": "TestNoConflictingSessionsDoesNotWaitOrLogoff"
      },
      "linux": {
        "file": "internal/agent/agent_test.go",
        "test": "TestPrepareSessionRefusesUnsafeProfilesAndReleasesHybridSessions"
      }
    },
    {
      "id": "power.required-wake-blocks-shutdown",
      "windows": {
        "file": "labstation/tests/PowerManagerTests.ahk",
        "test": "TestWakeIssuesCanBlockPowerAction"
      },
      "linux": {
        "file": "internal/agent/agent_test.go",
        "test": "TestPowerHonorsWakeRequirementAndHibernateCapability"
      }
    },
    {
      "id": "recovery.gates-unnecessary-reboot",
      "windows": {
        "file": "labstation/tests/RecoveryTests.ahk",
