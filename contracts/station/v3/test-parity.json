      "linux": {
        "file": "internal/agent/dispatcher_test.go",
        "test": "TestDispatchRejectsMalformedUnknownAndMultiObjectRequests"
      }
    },
    {
      "id": "services.report-platform-service-state",
      "windows": {
        "file": "labstation/tests/ServiceManagerTests.ahk",
