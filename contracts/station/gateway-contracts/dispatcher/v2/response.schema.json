{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DecentraLabsCom/Lab-Gateway/main/contracts/station/dispatcher/v2/response.schema.json",
  "title": "Lab Station dispatcher response v2",
  "description": "Correlated result returned for dispatcher v2 execute and operation.status requests.",
  "type": "object",
  "required": ["id", "command", "completedAt", "success", "exitCode", "outcome", "message", "stdout", "stderr", "durationMs", "metadata"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "command": {"type": "string", "minLength": 1},
    "completedAt": {"type": "string", "format": "date-time"},
    "success": {"type": "boolean"},
    "exitCode": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["success", "warning", "failure"]},
    "message": {"type": "string"},
    "options": {"type": "array", "items": {"type": "string", "maxLength": 256}, "maxItems": 16},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "durationMs": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"exitCode": {"const": 0}}, "required": ["exitCode"]},
      "then": {"properties": {"success": {"const": true}, "outcome": {"const": "success"}}}
    },
    {
      "if": {"properties": {"exitCode": {"const": 1}}, "required": ["exitCode"]},
      "then": {"properties": {"success": {"const": true}, "outcome": {"const": "warning"}}}
    },
    {
      "if": {"properties": {"exitCode": {"minimum": 2}}, "required": ["exitCode"]},
      "then": {"properties": {"success": {"const": false}, "outcome": {"const": "failure"}}}
    }
  ],
  "additionalProperties": false
}
